# Public-safe local application defaults; no secrets are required.
DOFUS_APP_DATABASE_PATH=data/app/dofus_touch.sqlite3
DOFUS_MARKET_CONTEXT=unspecified
DOFUS_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional Slack screenshot worker. Supply secret values outside Git before starting it.
DOFUS_SLACK_WORKSPACE_ID=
DOFUS_SLACK_CHANNEL_ID=
DOFUS_SLACK_OWNER_USER_ID=
DOFUS_SLACK_EVIDENCE_PATH=data/app/slack_sales_evidence
DOFUS_SLACK_CODEX_BINARY=codex
# Leave blank to use the subscription's current Codex CLI default model.
DOFUS_SLACK_CODEX_MODEL=
DOFUS_SLACK_CODEX_TIMEOUT_SECONDS=180
DOFUS_SLACK_APPROVED_PROFESSIONS=Tailor,Shoemaker,Jeweller
DOFUS_SLACK_SOLD_AUTO_COMMIT=false
DOFUS_SLACK_MARKET_AUTO_COMMIT=false
# DOFUS_SLACK_BOT_TOKEN and DOFUS_SLACK_APP_TOKEN are required only by the
# worker and intentionally have no public-safe example values.
